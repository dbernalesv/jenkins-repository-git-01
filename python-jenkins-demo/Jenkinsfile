@Library('jenkins-shared-library') _

pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {

        // SonarQube
        SONAR_SERVER = 'sonarqube-server'
        SONAR_SCANNER = 'sonar-scanner'

        // Google Artifact Registry
        GAR_HOST = 'us-south1-docker.pkg.dev'
        GCP_PROJECT = 'marine-service-508414-q7'
        GAR_REPOSITORY = 'jenkins-python-images'
        IMAGE_NAME = 'python-jenkins-demo'

        // Imagen completa con tag dinámico = número de build
        IMAGE_FULL_NAME = "${GAR_HOST}/${GCP_PROJECT}/${GAR_REPOSITORY}/${IMAGE_NAME}:${BUILD_NUMBER}"
    }

    stages {

        stage('Get Source') {

            steps {

                checkout scm

                echo "Build: ${env.BUILD_NUMBER}"

                sh '''
                    echo "Commit:"
                    git rev-parse --short HEAD

                    echo "Branch/remoto:"
                    git branch -a
                '''
            }
        }


        stage('Build and Sonar in Parallel') {

            parallel {

                stage('Build / Test') {

                    agent {
                        docker {
                            image 'python:3.11-slim'
                            args '-u root'
                            reuseNode true
                        }
                    }

                    steps {

                        dir('python-jenkins-demo') {

                            sh '''
                                echo "======================================"
                                echo " BUILD / TEST"
                                echo "======================================"

                                python --version

                                python -m venv .venv

                                .venv/bin/python -m pip install --upgrade pip

                                .venv/bin/pip install \
                                    --no-cache-dir \
                                    -r requirements.txt

                                .venv/bin/python -m pytest
                            '''
                        }
                    }
                }


                stage('SonarQube') {

                    steps {

                        dir('python-jenkins-demo') {

                            script {

                                def scannerHome = tool "${SONAR_SCANNER}"

                                withSonarQubeEnv("${SONAR_SERVER}") {

                                    sh """
                                        echo "======================================"
                                        echo " SONARQUBE ANALYSIS"
                                        echo "======================================"

                                        ${scannerHome}/bin/sonar-scanner \
                                            -Dsonar.projectKey=jenkins-repository-git-01 \
                                            -Dsonar.projectName=jenkins-repository-git-01 \
                                            -Dsonar.sources=. \
                                            -Dsonar.tests=tests \
                                            -Dsonar.test.inclusions=tests/**/*.py \
                                            -Dsonar.exclusions=tests/**,__pycache__/**,.pytest_cache/**,.venv/** \
                                            -Dsonar.python.version=3.11
                                    """
                                }
                            }
                        }
                    }
                }
            }
        }


        stage('Docker Build') {

            steps {

                dir('python-jenkins-demo') {

                    sh '''
                        echo "======================================"
                        echo " DOCKER BUILD"
                        echo "======================================"

                        echo "Construyendo imagen:"
                        echo "${IMAGE_FULL_NAME}"

                        docker build \
                            -t "${IMAGE_FULL_NAME}" \
                            .
                    '''
                }
            }
        }


        stage('Publish Docker Image') {

            steps {

                echo '======================================'
                echo ' PUBLISH DOCKER IMAGE'
                echo '======================================'

                garLogin("${GAR_HOST}")

                garPush("${IMAGE_FULL_NAME}")

                sh '''
                    docker logout "${GAR_HOST}"
                '''
            }
        }
    }


    post {

        success {

            echo '======================================'
            echo ' PIPELINE FINALIZADO CORRECTAMENTE'
            echo " Imagen publicada: ${IMAGE_FULL_NAME}"
            echo '======================================'
        }

        failure {

            echo '======================================'
            echo ' PIPELINE FALLÓ'
            echo ' Revisar Console Output'
            echo '======================================'
        }

        always {

            echo "Build finalizado: ${BUILD_NUMBER}"
        }
    }
}