pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        SONAR_SERVER = 'sonarqube-server'
        SONAR_SCANNER = 'sonar-scanner'
    }

    stages {

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.REPO_NAME = sh(
                        script: "basename -s .git \$(git config --get remote.origin.url)",
                        returnStdout: true
                    ).trim()
                }

                echo "Repositorio: ${env.REPO_NAME}"

                sh '''
                    echo "Branch actual:"
                    git branch --show-current || true

                    echo "Commit:"
                    git rev-parse --short HEAD
                '''
            }
        }


        stage('Preparar Python') {

            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-u root'
                    reuseNode true
                }
            }

            steps {

                dir('python-jenkins-demo') {

                    sh '''
                        echo "======================================"
                        echo " Preparando entorno Python"
                        echo "======================================"

                        python --version

                        python -m venv .venv

                        .venv/bin/python -m pip install --upgrade pip

                        .venv/bin/pip install \
                            --no-cache-dir \
                            -r requirements.txt

                        echo "Dependencias instaladas:"
                        .venv/bin/pip list
                    '''
                }
            }
        }


        stage('Pruebas') {

            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-u root'
                    reuseNode true
                }
            }

            steps {

                dir('python-jenkins-demo') {

                    sh '''
                        echo "======================================"
                        echo " Ejecutando pruebas"
                        echo "======================================"

                        .venv/bin/python -m pytest
                    '''
                }
            }
        }


        stage('SonarQube analysis') {

            steps {

                script {

                    scannerHome = tool "${SONAR_SCANNER}"

                    echo "SonarScanner instalado en: ${scannerHome}"
                }

                dir('python-jenkins-demo') {

                    withSonarQubeEnv("${SONAR_SERVER}") {

                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=${REPO_NAME} \
                                -Dsonar.projectName=${REPO_NAME} \
                                -Dsonar.sources=. \
                                -Dsonar.tests=tests \
                                -Dsonar.test.inclusions=tests/**/*.py \
                                -Dsonar.exclusions=tests/**,__pycache__/**,.pytest_cache/**,.venv/**
                        """
                    }
                }
            }
        }
    }


    post {

        success {

            echo '======================================'
            echo ' PIPELINE FINALIZADO CORRECTAMENTE'
            echo ' Análisis SonarQube ejecutado'
            echo '======================================'
        }

        failure {

            echo '======================================'
            echo ' PIPELINE FALLÓ'
            echo ' Revisar pruebas o análisis SonarQube'
            echo '======================================'
        }

        always {

            echo "Repositorio analizado: ${env.REPO_NAME ?: 'N/A'}"
        }
    }
}
